# Firebase Web (cliente). Estas chaves são públicas por desenho do Firebase:
# a proteção fica nas regras do Firestore e do Storage, não em escondê-las.
NEXT_PUBLIC_API_KEY=
NEXT_PUBLIC_AUTH_DOMAIN=
NEXT_PUBLIC_PROJECT_ID=
NEXT_PUBLIC_STORAGE_BUCKET=
NEXT_PUBLIC_MESSAGE_SENDER_ID=
NEXT_PUBLIC_APP_ID=
NEXT_PUBLIC_MEASUREMENT_ID=

# URL pública do site (sitemap, Open Graph, robots). Em preview/produção na Vercel, VERCEL_URL é usado se vazio.
NEXT_PUBLIC_SITE_URL=

# Cloudinary. O cloud name aparece nas URLs das imagens e pode ser público.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
# Credenciais só do servidor (src/app/api/image/upload/route.ts).
# Não use o prefixo NEXT_PUBLIC_: ele entra no JavaScript enviado ao navegador.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Conta SMTP (servidor). Sem estas variáveis o aviso interno continua e o e-mail fica como não configurado.
EMAIL_TO=
GMAIL_APP_PASSWORD=

# E-mail público de contato, exibido no site. Não reutilize EMAIL_TO aqui.
NEXT_PUBLIC_CONTACT_EMAIL=

# Emuladores Firebase (somente local/e2e). Ver docs/e2e-mobile.md
# NEXT_PUBLIC_FIREBASE_EMULATOR=true
# NEXT_PUBLIC_FIREBASE_EMULATOR_HOST=127.0.0.1

# Feature toggles (cliente). Valor `true` ou `1` habilita; omitido ou qualquer outro valor usa o default do código.
# NEXT_PUBLIC_FEATURE_DASHBOARD_CUSTOMIZATION=true

# Não há variável de gateway de pagamento: a contratação não confirma pagamento até um provedor real ser ligado.
# Login com Google usa o mesmo projeto Firebase. Ative o provedor Google em Authentication
# e autorize o domínio (localhost e o domínio de produção).

# Google Agenda (servidor). Sem estas variáveis a integração aparece como indisponível.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Opcional: se omitida, o redirect é derivado da origem da requisição.
GOOGLE_OAUTH_REDIRECT_URI=
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Firebase Admin (servidor) para validar ID tokens e gravar integrations/{uid}.
# Use o JSON completo OU e-mail + chave privada da conta de serviço.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
