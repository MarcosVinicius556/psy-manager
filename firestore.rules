rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsNew() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function isSuperAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "super_admin";
    }

    function isSupportStaff() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["super_admin", "support"];
    }

    function supportTicketOpener() {
      return signedIn()
        && resource.data.openedBy.uid == request.auth.uid;
    }

    function accountData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function integralWritesOpen(user) {
      return user.billingAccess == "integral"
        && (
          !("cancelAtPeriodEnd" in user)
          || user.cancelAtPeriodEnd != true
          || ("accessUntilMillis" in user && user.accessUntilMillis > request.time.toMillis())
        )
        && (
          !("paidUntilMillis" in user)
          || user.paidUntilMillis == 0
          || user.paidUntilMillis > request.time.toMillis()
        );
    }

    function clinicWritesOpen() {
      let user = accountData();
      return !("billingAccess" in user)
        || (
          (!("accountStatus" in user) || (user.accountStatus != "suspensa" && user.accountStatus != "desativada"))
          && (
            user.billingAccess == "legado"
            || integralWritesOpen(user)
            || (
              user.billingAccess == "trial"
              && user.subscriptionStatus == "trial_ativo"
              && user.trialEndsAtMillis > request.time.toMillis()
            )
          )
        );
    }

    function roleStable() {
      return request.resource.data.role == resource.data.role
        || (!("role" in resource.data) && request.resource.data.role == "psicologo");
    }

    function billingAccessSame() {
      return ("billingAccess" in resource.data)
        ? request.resource.data.billingAccess == resource.data.billingAccess
        : !("billingAccess" in request.resource.data);
    }

    function subscriptionSame() {
      return ("subscriptionStatus" in resource.data)
        ? request.resource.data.subscriptionStatus == resource.data.subscriptionStatus
        : !("subscriptionStatus" in request.resource.data);
    }

    function planSame() {
      return ("planId" in resource.data)
        ? request.resource.data.planId == resource.data.planId
        : !("planId" in request.resource.data);
    }

    function accountStatusSame() {
      return ("accountStatus" in resource.data)
        ? request.resource.data.accountStatus == resource.data.accountStatus
        : !("accountStatus" in request.resource.data);
    }

    function trialEndSame() {
      return ("trialEndsAtMillis" in resource.data)
        ? request.resource.data.trialEndsAtMillis == resource.data.trialEndsAtMillis
        : !("trialEndsAtMillis" in request.resource.data);
    }

    function trialStartSame() {
      return ("trialStartedAtMillis" in resource.data)
        ? request.resource.data.trialStartedAtMillis == resource.data.trialStartedAtMillis
        : !("trialStartedAtMillis" in request.resource.data);
    }

    function checkoutSame() {
      return (
        ("checkoutStatus" in resource.data)
          ? request.resource.data.checkoutStatus == resource.data.checkoutStatus
          : !("checkoutStatus" in request.resource.data)
      ) && (
        ("checkoutPlanId" in resource.data)
          ? request.resource.data.checkoutPlanId == resource.data.checkoutPlanId
          : !("checkoutPlanId" in request.resource.data)
      ) && (
        ("pixTxid" in resource.data)
          ? request.resource.data.pixTxid == resource.data.pixTxid
          : !("pixTxid" in request.resource.data)
      );
    }

    function paidUntilSame() {
      return ("paidUntilMillis" in resource.data)
        ? request.resource.data.paidUntilMillis == resource.data.paidUntilMillis
        : !("paidUntilMillis" in request.resource.data);
    }

    function cancelAtPeriodEndSame() {
      return ("cancelAtPeriodEnd" in resource.data)
        ? request.resource.data.cancelAtPeriodEnd == resource.data.cancelAtPeriodEnd
        : !("cancelAtPeriodEnd" in request.resource.data);
    }

    function accessUntilSame() {
      return ("accessUntilMillis" in resource.data)
        ? request.resource.data.accessUntilMillis == resource.data.accessUntilMillis
        : !("accessUntilMillis" in request.resource.data);
    }

    // cancelAtPeriodEnd/accessUntilMillis keep integral access open after a scheduled
    // cancellation (integralWritesOpen), so the user cannot edit them outside selfCancelPaid.
    function cancelWindowSame() {
      return cancelAtPeriodEndSame() && accessUntilSame();
    }

    // Trial/courtesy cancellation may only clear the window (false / 0), never extend it.
    function cancelWindowClearedOrSame() {
      return (cancelAtPeriodEndSame() || request.resource.data.cancelAtPeriodEnd == false)
        && (accessUntilSame() || request.resource.data.accessUntilMillis == 0);
    }

    function billingUntouched() {
      return billingAccessSame() && subscriptionSame() && planSame() && accountStatusSame() && trialEndSame() && trialStartSame() && checkoutSame() && paidUntilSame() && cancelWindowSame();
    }

    function selfExpireTrial() {
      return resource.data.subscriptionStatus == "trial_ativo"
        && resource.data.trialEndsAtMillis <= request.time.toMillis()
        && request.resource.data.subscriptionStatus == "trial_expirado"
        && request.resource.data.billingAccess == "restrito"
        && planSame()
        && accountStatusSame()
        && trialEndSame()
        && trialStartSame()
        && roleStable()
        && checkoutSame()
        && paidUntilSame()
        && cancelWindowSame();
    }

    function selfAdoptLegacy() {
      return !("billingAccess" in resource.data)
        && request.resource.data.billingAccess == "legado"
        && request.resource.data.subscriptionStatus == "legado"
        && request.resource.data.accountStatus == "ativa"
        && request.resource.data.planId == "legado"
        && roleStable();
    }

    function selfCancel() {
      return resource.data.subscriptionStatus in ["trial_ativo", "cortesia"]
        && request.resource.data.subscriptionStatus == "cancelada"
        && request.resource.data.billingAccess == "restrito"
        && planSame()
        && accountStatusSame()
        && trialEndSame()
        && roleStable()
        && checkoutSame()
        && paidUntilSame()
        && cancelWindowClearedOrSame();
    }

    function selfCancelPaid() {
      return resource.data.subscriptionStatus == "ativa"
        && resource.data.billingAccess == "integral"
        && request.resource.data.subscriptionStatus == "ativa"
        && request.resource.data.billingAccess == "integral"
        && request.resource.data.cancelAtPeriodEnd == true
        && (!("cancelAtPeriodEnd" in resource.data) || resource.data.cancelAtPeriodEnd != true)
        && request.resource.data.accessUntilMillis is int
        && request.resource.data.accessUntilMillis >= request.time.toMillis()
        && request.resource.data.accessUntilMillis == resource.data.paidUntilMillis
        && planSame()
        && accountStatusSame()
        && trialEndSame()
        && roleStable()
        && checkoutSame();
    }

    function selfCheckout() {
      return request.resource.data.checkoutStatus == "aguardando_confirmacao_pix"
        && request.resource.data.checkoutPlanId is string
        && request.resource.data.checkoutPlanId.size() > 0
        && request.resource.data.checkoutPlanId != "avaliacao"
        && request.resource.data.pixTxid is string
        && request.resource.data.pixTxid.size() > 0
        && subscriptionSame()
        && billingAccessSame()
        && planSame()
        && accountStatusSame()
        && trialEndSame()
        && paidUntilSame()
        && cancelWindowSame()
        && roleStable();
    }

    // compat: master client path, remove after promote.
    // master's checkoutPatch() writes checkoutStatus "aguardando_provedor" without pixTxid.
    // It only records the request; access fields stay locked.
    function selfCheckoutLegacyMaster() {
      return request.resource.data.checkoutStatus == "aguardando_provedor"
        && request.resource.data.checkoutPlanId is string
        && request.resource.data.checkoutPlanId.size() > 0
        && !(request.resource.data.checkoutPlanId in ["avaliacao", "legado"])
        && (
          ("pixTxid" in resource.data)
            ? request.resource.data.pixTxid == resource.data.pixTxid
            : !("pixTxid" in request.resource.data)
        )
        && subscriptionSame()
        && billingAccessSame()
        && planSame()
        && accountStatusSame()
        && trialEndSame()
        && trialStartSame()
        && paidUntilSame()
        && cancelWindowSame()
        && roleStable();
    }

    function paymentReminderCountStable() {
      return !("lembretesEnviados" in request.resource.data)
        || (
          ("lembretesEnviados" in resource.data)
            ? request.resource.data.lembretesEnviados == resource.data.lembretesEnviados
            : request.resource.data.lembretesEnviados == 0
        );
    }

    function emailMatches() {
      return request.auth.token.email is string
        && request.resource.data.email == request.auth.token.email.lower();
    }

    function trialClaim() {
      return get(/databases/$(database)/documents/trialClaims/$(request.resource.data.email)).data;
    }

    function ownsTrialClaim() {
      return exists(/databases/$(database)/documents/trialClaims/$(request.resource.data.email))
        && trialClaim().uid == request.auth.uid;
    }

    function foreignTrialClaim() {
      return exists(/databases/$(database)/documents/trialClaims/$(request.resource.data.email))
        && trialClaim().uid != request.auth.uid;
    }

    function validSelfTrial() {
      return request.resource.data.role == "psicologo"
        && request.resource.data.billingAccess == "trial"
        && request.resource.data.subscriptionStatus == "trial_ativo"
        && request.resource.data.accountStatus == "ativa"
        && request.resource.data.planId == "avaliacao"
        && request.resource.data.trialEndsAtMillis is int
        && request.resource.data.trialStartedAtMillis is int
        && request.resource.data.trialEndsAtMillis > request.time.toMillis() + 2505600000
        && request.resource.data.trialEndsAtMillis < request.time.toMillis() + 2678400000
        && request.resource.data.trialStartedAtMillis > request.time.toMillis() - 86400000
        && request.resource.data.trialStartedAtMillis < request.time.toMillis() + 86400000
        && request.resource.data.termsAcceptedAt is string
        && emailMatches()
        && ownsTrialClaim();
    }

    function replayDenied() {
      return request.resource.data.role == "psicologo"
        && request.resource.data.billingAccess == "restrito"
        && request.resource.data.subscriptionStatus == "trial_expirado"
        && request.resource.data.accountStatus == "ativa"
        && request.resource.data.planId == "avaliacao"
        && request.resource.data.trialEndsAtMillis <= request.time.toMillis()
        && emailMatches()
        && foreignTrialClaim();
    }

    function shareMoneyLocked(index) {
      return resource.data.shares.size() <= index
        || (
          request.resource.data.shares[index].memberId == resource.data.shares[index].memberId
          && request.resource.data.shares[index].valor == resource.data.shares[index].valor
        );
    }

    function adminDoesNotFabricatePayment() {
      return !(request.resource.data.subscriptionStatus in ["ativa", "pagamento_pendente", "pagamento_atrasado"])
        || (("subscriptionStatus" in resource.data) && request.resource.data.subscriptionStatus == resource.data.subscriptionStatus);
    }

    function staffActsFor(ownerUid) {
      return signedIn()
        && request.auth.token.staffOf == ownerUid
        && request.auth.token.staffPerms is list;
    }

    function clinicAdminReadsMember(memberUid) {
      return signedIn()
        && request.auth.token.clinicRole == "admin"
        && request.auth.token.clinicId is string
        && exists(/databases/$(database)/documents/clinics/$(request.auth.token.clinicId))
        && get(/databases/$(database)/documents/clinics/$(request.auth.token.clinicId)).data.adminUid == request.auth.uid
        && (
          memberUid == request.auth.uid
          || memberUid in get(/databases/$(database)/documents/clinics/$(request.auth.token.clinicId)).data.memberUids
        );
    }

    function tenantStaffRead() {
      return signedIn() && staffActsFor(resource.data.ownerUid);
    }

    function tenantRead() {
      return signedIn()
        && resource.data.keys().hasAny(["ownerUid"])
        && (
          resource.data.ownerUid == request.auth.uid
          || tenantStaffRead()
          || clinicAdminReadsMember(resource.data.ownerUid)
        );
    }

    function staffTenantWriteOwner(ownerUid) {
      return staffActsFor(ownerUid);
    }

    function tenantCreate() {
      return clinicWritesOpen() && (
        ownsNew()
        || (
          signedIn()
          && staffTenantWriteOwner(request.resource.data.ownerUid)
          && request.resource.data.ownerUid is string
        )
      );
    }

    function tenantUpdate() {
      return signedIn()
        && clinicWritesOpen()
        && resource.data.keys().hasAny(["ownerUid"])
        && request.resource.data.ownerUid == resource.data.ownerUid
        && (
          (
            resource.data.ownerUid == request.auth.uid
            && request.resource.data.ownerUid == request.auth.uid
          )
          || staffTenantWriteOwner(resource.data.ownerUid)
          || (
            clinicAdminReadsMember(resource.data.ownerUid)
            && request.auth.token.clinicRole == "admin"
          )
        );
    }

    function tenantDelete() {
      return ownsExisting() && clinicWritesOpen();
    }

    function noClinicalOnAppointment() {
      return !request.resource.data.keys().hasAny(["clinical"]);
    }

    function appointmentFuture() {
      return resource.data.sessionStartMillis is int
        && resource.data.sessionStartMillis > request.time.toMillis();
    }

    function appointmentConfirmationFieldsStable() {
      return (
        !("confirmacao" in request.resource.data)
        || request.resource.data.confirmacao == resource.data.confirmacao
      ) && (
        !("confirmadaEm" in request.resource.data)
        || request.resource.data.confirmadaEm == resource.data.confirmadaEm
      );
    }

    function locationInviteAccepted(locationId) {
      return exists(/databases/$(database)/documents/locationInvites/$(locationId + "_" + request.auth.uid))
        && get(/databases/$(database)/documents/locationInvites/$(locationId + "_" + request.auth.uid)).data.status == "aceito";
    }

    function feedbackAnswerFieldsUnset() {
      return request.resource.data.stars == null
        && request.resource.data.comment == ""
        && request.resource.data.answeredAt == null
        && request.resource.data.answeredAtMillis == null;
    }

    function politicaFaltaValid(data) {
      return !("politicaFalta" in data)
        || (
          data.politicaFalta.horas is int
          && data.politicaFalta.horas >= 0
          && data.politicaFalta.horas <= 168
          && data.politicaFalta.percentual is int
          && data.politicaFalta.percentual >= 0
          && data.politicaFalta.percentual <= 100
        );
    }

    function memberPrivateFieldKeys() {
      return [
        "cpf",
        "crpNumero",
        "crpRegiao",
        "enderecoLogradouro",
        "enderecoCidade",
        "enderecoUf",
        "enderecoCep",
        "pixChave",
        "pixTipo",
        "pixNome",
        "pixCidade",
      ];
    }

    function validPixTipo(value) {
      return value == "" || value in ["cpf", "cnpj", "email", "telefone", "aleatoria"];
    }

    function validMemberPrivatePix() {
      return (!("pixChave" in request.resource.data) || request.resource.data.pixChave is string && request.resource.data.pixChave.size() <= 120)
        && (!("pixTipo" in request.resource.data) || validPixTipo(request.resource.data.pixTipo))
        && (!("pixNome" in request.resource.data) || request.resource.data.pixNome is string && request.resource.data.pixNome.size() <= 80)
        && (!("pixCidade" in request.resource.data) || request.resource.data.pixCidade is string && request.resource.data.pixCidade.size() <= 40);
    }

    function noMemberPrivateOnMember() {
      return !request.resource.data.keys().hasAny(memberPrivateFieldKeys());
    }

    function patientOwnerRead() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function patientStaffRead() {
      return signedIn() && staffActsFor(resource.data.ownerUid);
    }

    function patientReadAllowed() {
      return patientOwnerRead() || patientStaffRead();
    }

    function noPatientPrivateOnPatient() {
      return !request.resource.data.keys().hasAny(["observacoes", "contatoEmergencia"]);
    }

    // compat: master client path, remove after promote.
    // master keeps observacoes/contatoEmergencia on patients (develop moved them to
    // patientPrivate). Only the tenant owner writing directly may keep them; staff writes
    // still need noPatientPrivateOnPatient().
    function ownerKeepsLegacyPatientFields() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function masterClinicalKeys() {
      return [
        "mood",
        "clinicalEvolution",
        "notes",
        "aspectosCognitivos",
        "aspectosEmocionais",
        "intervencoes",
        "objetivos",
        "evolucaoSessao",
        "anamneseArquivos",
        "atividadesArquivos",
      ];
    }

    // compat: master client path, remove after promote.
    // master stores the session record inside appointments.clinical, always with the full
    // shape built by mapClinical()/emptyClinical(). Owner-only; develop clients never send it.
    function masterClinicalShape(clinical) {
      return clinical is map
        && clinical.keys().hasAll(masterClinicalKeys())
        && clinical.keys().hasOnly(masterClinicalKeys())
        && clinical.anamneseArquivos is list
        && clinical.atividadesArquivos is list;
    }

    function appointmentClinicalOkOnCreate() {
      return noClinicalOnAppointment()
        || (ownsNew() && masterClinicalShape(request.resource.data.clinical));
    }

    // Updates that do not touch `clinical` are fine even on legacy docs that already carry it
    // (both master and develop edit status/date on those docs).
    function appointmentClinicalOkOnUpdate() {
      return noClinicalOnAppointment()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(["clinical"])
        || masterClinicalShape(request.resource.data.clinical);
    }

    // The user's own roster row in members (uid == ownerUid == caller). Login (upsertPsychologist,
    // master and develop) creates/syncs it before or regardless of the billing state, so it does
    // not depend on clinicWritesOpen(). Only identity fields may change through this path.
    function selfMemberRowNew() {
      return signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;
    }

    function selfMemberRowSync() {
      return signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["uid", "ownerUid", "email", "nome", "foto", "ativo"]);
    }

    // compat: master client path, remove after promote.
    // master appointments have no sessionStartMillis, so appointmentFuture() can never hold.
    // An invitee may still add only itself when the owner listed the appointment in the
    // accepted invite (createLocationInvite stores appointmentIds).
    function masterInviteListsAppointment(locationId, appointmentId) {
      return !("sessionStartMillis" in resource.data)
        && appointmentId in get(/databases/$(database)/documents/locationInvites/$(locationId + "_" + request.auth.uid)).data.appointmentIds;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
      allow create: if signedIn()
        && request.resource.data.uid == userId
        && request.resource.data.role == "psicologo"
        && (
          (request.auth.uid == userId && (validSelfTrial() || replayDenied()))
          || (
            isSuperAdmin()
            && request.resource.data.billingAccess == "legado"
            && request.resource.data.subscriptionStatus == "legado"
            && request.resource.data.accountStatus == "ativa"
          )
        );
      allow update: if signedIn() && request.auth.uid == userId && roleStable() && (
        billingUntouched() || selfExpireTrial() || selfAdoptLegacy() || selfCancel() || selfCancelPaid() || selfCheckout()
        || selfCheckoutLegacyMaster()
      );
      allow update: if isSuperAdmin()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.role == resource.data.role
        && adminDoesNotFabricatePayment();
      allow delete: if false;

      match /inbox/{messageId} {
        allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow create: if signedIn()
          && request.auth.uid == userId
          && messageId in ["boas_vindas", "trial_7", "trial_3", "trial_1", "trial_expirado", "ativacao_d2", "ativacao_d5"]
          && request.resource.data.kind == messageId
          && request.resource.data.categoria == "operacional"
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() < 200
          && request.resource.data.corpo is string
          && request.resource.data.corpo.size() < 4000;
        allow create: if isSuperAdmin()
          && request.resource.data.titulo is string
          && request.resource.data.titulo.size() < 200
          && request.resource.data.corpo is string
          && request.resource.data.corpo.size() < 4000;
        allow update: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["lida", "lidaEm", "emailResult"]);
        allow update: if isSuperAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["emailResult"]);
        allow delete: if false;
      }

      match /billingEvents/{eventId} {
        allow read: if signedIn() && (request.auth.uid == userId || isSuperAdmin());
        allow create: if signedIn()
          && request.auth.uid == userId
          && request.resource.data.tipo in ["checkout_solicitado", "cancelamento_solicitado"]
          && request.resource.data.resultado == "registrado";
        allow create: if isSuperAdmin()
          && request.resource.data.tipo in ["alteracao_plano", "extensao_trial", "encerramento_trial", "cortesia", "encerramento_cortesia", "suspensao", "reativacao", "desativacao", "ajuste"]
          && request.resource.data.resultado == "registrado";
        allow update, delete: if false;
      }
    }

    match /trialClaims/{emailId} {
      allow get: if signedIn() && request.auth.token.email is string && request.auth.token.email.lower() == emailId;
      allow list: if isSuperAdmin();
      allow create: if signedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == emailId
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == emailId;
      allow update, delete: if false;
    }

    match /plans/{planId} {
      allow read: if true;
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    match /platformAudit/{eventId} {
      allow read, create: if isSuperAdmin();
      allow update, delete: if false;
    }

    match /platformMessages/{messageId} {
      allow read, create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "enviados", "falhas", "concluidoEm"]);
      allow delete: if false;
    }

    match /memberPrivate/{uid} {
      // listMembers() (develop) reads the caller's own doc even when it does not exist yet.
      allow get: if signedIn() && request.auth.uid == uid && (resource == null || resource.data.ownerUid == request.auth.uid);
      allow read: if signedIn() && request.auth.uid == uid && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.ownerUid == request.auth.uid
        && validMemberPrivatePix();
      allow update: if signedIn()
        && request.auth.uid == uid
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && validMemberPrivatePix();
      allow delete: if signedIn() && request.auth.uid == uid && resource.data.ownerUid == request.auth.uid;
    }

    match /members/{memberId} {
      // No "unowned doc" branch: it let any signed-in user list every tenant's roster.
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.uid == request.auth.uid
      );
      // develop upsertPsychologist() reads the canonical members/{uid} doc before it exists.
      allow get: if signedIn() && memberId == request.auth.uid && resource == null;
      allow create: if noMemberPrivateOnMember() && (
        tenantCreate()
        || selfMemberRowNew()
        || (
          isSuperAdmin()
          && request.resource.data.uid is string
          && request.resource.data.ownerUid == request.resource.data.uid
          && request.resource.data.email is string
        )
      );
      allow update: if tenantUpdate() && noMemberPrivateOnMember() && politicaFaltaValid(request.resource.data);
      allow update: if selfMemberRowSync() && noMemberPrivateOnMember() && politicaFaltaValid(request.resource.data);
      allow delete: if tenantDelete();
    }

    match /directory/{emailId} {
      allow get: if signedIn();
      allow create, update: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == emailId
        && request.resource.data.ownerUid == request.auth.uid;
      allow create, update: if isSuperAdmin()
        && request.resource.data.email == emailId
        && request.resource.data.uid is string
        && request.resource.data.ownerUid == request.resource.data.uid;
      allow delete: if false;
    }

    match /locationInvites/{inviteId} {
      allow read: if signedIn()
        && (
          (resource.data.keys().hasAll(["inviteeUid"]) && resource.data.inviteeUid == request.auth.uid)
          || resource.data.ownerUid == request.auth.uid
        );
      allow update: if signedIn()
        && resource.data.inviteeUid == request.auth.uid
        && resource.data.status == "pendente"
        && request.resource.data.inviteeUid == resource.data.inviteeUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.locationId == resource.data.locationId
        && request.resource.data.status in ["aceito", "recusado"];
      // createLocationInvite() (master and develop): the location owner invites another user.
      allow create: if signedIn()
        && clinicWritesOpen()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.inviteeUid is string
        && request.resource.data.inviteeUid != request.auth.uid
        && request.resource.data.locationId is string
        && inviteId == request.resource.data.locationId + "_" + request.resource.data.inviteeUid
        && request.resource.data.status == "pendente"
        && exists(/databases/$(database)/documents/locations/$(request.resource.data.locationId))
        && get(/databases/$(database)/documents/locations/$(request.resource.data.locationId)).data.ownerUid == request.auth.uid
        && (!("appointmentIds" in request.resource.data) || request.resource.data.appointmentIds is list)
        && (!("expenseIds" in request.resource.data) || request.resource.data.expenseIds is list);
    }

    match /locations/{locationId} {
      // Owner listing (listShared owned query, not wrapped in try/catch on master).
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow create: if tenantCreate();
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && clinicWritesOpen()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow update: if signedIn()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["memberUids"])
        && request.resource.data.memberUids.hasAll(resource.data.memberUids)
        && request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([request.auth.uid]))
        && locationInviteAccepted(locationId);
      allow delete: if ownsExisting() && clinicWritesOpen();
    }

    match /clinicalRecords/{recordId} {
      allow read, write: if false;
    }

    match /keys/{uid} {
      allow read, write: if false;
    }

    match /consentRecords/{recordId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /signatureRequests/{token} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && ownsNew() && clinicWritesOpen();
      allow update, delete: if false;
    }

    match /formTemplates/{templateId} {
      allow read: if ownsExisting();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /formRequests/{token} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && ownsNew() && clinicWritesOpen();
      allow update, delete: if false;
    }

    match /formResponses/{responseId} {
      allow read: if ownsExisting();
      allow create, update, delete: if false;
    }

    match /clinicalAccessLog/{logId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /appointments/{appointmentId} {
      // Owner listing (listShared owned query, data export, demo cleanup).
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.accessUids;
      allow create: if tenantCreate()
        && appointmentClinicalOkOnCreate()
        && request.auth.uid in request.resource.data.accessUids;
      allow update: if ownsExisting()
        && clinicWritesOpen()
        && appointmentClinicalOkOnUpdate()
        && appointmentConfirmationFieldsStable()
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accessUids"])
        && request.resource.data.accessUids.hasAll(resource.data.accessUids)
        && request.resource.data.accessUids.hasOnly(resource.data.accessUids.concat([request.auth.uid]))
        && resource.data.locationId is string
        && locationInviteAccepted(resource.data.locationId)
        && (appointmentFuture() || masterInviteListsAppointment(resource.data.locationId, appointmentId));
      allow delete: if tenantDelete();
    }

    match /expenses/{expenseId} {
      // Owner listing (listShared owned query).
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow read: if signedIn() && request.auth.uid in resource.data.accessUids;
      allow create: if tenantCreate() && request.auth.uid in request.resource.data.accessUids;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["accessUids"])
        && request.resource.data.accessUids.hasAll(resource.data.accessUids)
        && request.resource.data.accessUids.hasOnly(resource.data.accessUids.concat([request.auth.uid]))
        && resource.data.locationId is string
        && locationInviteAccepted(resource.data.locationId);
      allow update: if signedIn()
        && request.auth.uid in resource.data.accessUids
        && request.resource.data.ownerUid == resource.data.ownerUid
        && clinicWritesOpen()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["paga", "parcelasRestantes", "vencimento", "shares"])
        && request.resource.data.shares.size() == resource.data.shares.size()
        && shareMoneyLocked(0) && shareMoneyLocked(1) && shareMoneyLocked(2) && shareMoneyLocked(3)
        && shareMoneyLocked(4) && shareMoneyLocked(5) && shareMoneyLocked(6) && shareMoneyLocked(7);
      allow update: if ownsExisting() && clinicWritesOpen() && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if tenantDelete();
    }

    match /patientPrivate/{docId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.patientId is string;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    match /patients/{patientId} {
      allow read: if patientReadAllowed();
      allow create: if tenantCreate()
        && (noPatientPrivateOnPatient() || ownerKeepsLegacyPatientFields())
        && (!("lembretesEmail" in request.resource.data) || request.resource.data.lembretesEmail is bool);
      allow update: if tenantUpdate()
        && (noPatientPrivateOnPatient() || (ownerKeepsLegacyPatientFields() && resource.data.ownerUid == request.auth.uid))
        && (!("lembretesEmail" in request.resource.data) || request.resource.data.lembretesEmail is bool);
      allow delete: if tenantDelete();
    }

    match /payments/{paymentId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate() && paymentReminderCountStable();
      allow delete: if tenantDelete();
    }

    match /packages/{packageId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /notifications/{notificationId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /reportTemplates/{templateId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /reportRuns/{runId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /contractTemplates/{templateId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /clinicalNoteTemplates/{templateId} {
      allow read: if ownsExisting();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /integrations/{uid} {
      allow read, write: if false;
    }

    match /emailIntegrations/{uid} {
      allow read, write: if false;
    }

    match /emailAutomationMarkers/{markerId} {
      allow read, write: if false;
    }

    match /emailTemplates/{templateId} {
      allow read: if tenantRead();
      allow create: if tenantCreate();
      allow update: if tenantUpdate();
      allow delete: if tenantDelete();
    }

    match /fechamentos/{closingId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      // getMonthClosing() reads `${uid}_${YYYYMM}` before the month is closed.
      allow get: if signedIn() && resource == null && closingId.matches(request.auth.uid + "_[0-9]{6}");
      allow create, update: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.month is string
        && request.resource.data.month.size() == 7
        && request.resource.data.closedAt is string;
      allow delete: if false;
    }

    match /emailLog/{logId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /legalAcceptances/{acceptanceId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /sessionFeedbacks/{token} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create: if signedIn() && ownsNew() && clinicWritesOpen() && feedbackAnswerFieldsUnset();
      // compat: master client path, remove after promote.
      // master's public /feedback/[token] page reads and answers the feedback with the client SDK
      // (no login). The token is a random UUID; only single-doc get (no list), and a single
      // answer before expiry. develop answers through /api/public/feedback (Admin SDK).
      allow get: if true;
      allow update: if resource.data.answeredAtMillis == null
        && resource.data.expiresAtMillis is int
        && resource.data.expiresAtMillis > request.time.toMillis()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["stars", "comment", "answeredAt", "answeredAtMillis"])
        && request.resource.data.stars is int
        && request.resource.data.stars >= 1
        && request.resource.data.stars <= 5
        && request.resource.data.comment is string
        && request.resource.data.comment.size() <= 2000
        && request.resource.data.answeredAt is string
        && request.resource.data.answeredAtMillis is int;
      allow delete: if false;
    }

    match /sessionConfirmations/{token} {
      allow read, write: if false;
    }

    match /pushTokens/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;

      match /devices/{deviceId} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn()
          && request.auth.uid == uid
          && request.resource.data.ownerUid == request.auth.uid
          && request.resource.data.subscription is map;
        allow delete: if signedIn() && request.auth.uid == uid;
      }
    }

    match /apiEmailRateLimits/{docId} {
      allow read, write: if false;
    }

    match /apiPublicFeedbackRateLimits/{docId} {
      allow read, write: if false;
    }

    match /bookingProfiles/{slug} {
      allow read, write: if false;
    }

    match /bookingAvailability/{uid} {
      allow read, write: if false;
    }

    match /bookingRequests/{requestId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /apiSupportRateLimits/{docId} {
      allow read, write: if false;
    }

    match /supportTicketCounters/{docId} {
      allow read, write: if false;
    }

    match /supportTickets/{ticketId} {
      allow read: if supportTicketOpener() || isSupportStaff();
      allow create, update, delete: if false;

      match /messages/{messageId} {
        allow read: if supportTicketOpener()
          || isSupportStaff();
        allow create, update, delete: if false;
      }

      match /history/{eventId} {
        allow read: if supportTicketOpener() || isSupportStaff();
        allow create, update, delete: if false;
      }

      match /attachments/{attachmentId} {
        allow read: if supportTicketOpener() || isSupportStaff();
        allow create, update, delete: if false;
      }

      match /botExecutions/{executionId} {
        allow read: if isSupportStaff();
        allow create, update, delete: if false;
      }
    }

    function activationEventNameAllowed(name) {
      return name == "signup"
        || name == "horarios_definidos"
        || name == "primeiro_paciente"
        || name == "primeira_sessao_concluida"
        || name == "primeiro_pagamento"
        || name == "primeiro_recibo"
        || name == "ativo_7_dias";
    }

    match /activationEvents/{eventId} {
      allow read: if isSuperAdmin();
      // recordActivationEvent() checks that its own `${uid}_${event}` doc does not exist yet
      // before writing it. Existing events stay platform-only (the denied read is caught).
      allow get: if signedIn()
        && resource == null
        && eventId.matches(request.auth.uid + "_[a-z0-9_]+");
      allow create: if signedIn()
        && request.resource.data.accountId == request.auth.uid
        && activationEventNameAllowed(request.resource.data.event)
        && request.resource.data.at is string
        && eventId == request.resource.data.accountId + "_" + request.resource.data.event
        && !exists(/databases/$(database)/documents/activationEvents/$(eventId));
      allow update, delete: if false;
    }

    match /trialNoticeMarkers/{markerId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    match /staffMembers/{memberId} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || resource.data.staffUid == request.auth.uid
      );
      allow create, update, delete: if false;
    }

    match /staffInvites/{token} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid
        || (
          request.auth.token.email is string
          && resource.data.inviteeEmail == request.auth.token.email.lower()
        )
      );
      allow create, update, delete: if false;
    }

    match /clinics/{clinicId} {
      allow read: if signedIn() && (
        resource.data.adminUid == request.auth.uid
        || request.auth.uid in resource.data.memberUids
      );
      allow create, update, delete: if false;
    }

    match /clinicInvites/{token} {
      allow read: if signedIn() && (
        resource.data.inviterUid == request.auth.uid
        || (
          request.auth.token.email is string
          && resource.data.inviteeEmail == request.auth.token.email.lower()
        )
      );
      allow create, update, delete: if false;
    }

    match /supervisionShares/{token} {
      allow read, write: if false;
    }

    match /supervisionExportLog/{eventId} {
      allow read: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if false;
    }

    match /patientAccounts/{uid} {
      allow read, write: if false;
    }

    match /portalInvites/{token} {
      allow read, write: if false;
    }

    match /patientJournal/{entryId} {
      allow read, write: if false;
    }

    match /patientTasks/{taskId} {
      allow read, write: if false;
    }

    match /patientMural/{messageId} {
      allow read, write: if false;
    }

    match /cronRuns/{runId} {
      allow read, write: if false;
    }
  }
}
